<style>
body {
  margin: 0;
}

.header-fixe {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: 80px;
  background: white;
  z-index: 1000;
  transition: box-shadow 0.3s ease;
}

.header-fixe.scrolled {
  box-shadow: 0 1px 1px rgba(0, 0, 0, 0.1);
}

.menu-wrapper {
  margin-top: 80px; /* espace pour le header fixe */
}

.menu-sticky {
  position: fixed; /* contrôle total */
  top: 80px; /* juste sous le header fixe */
  left: 0;
  width: 100%;
  background: white;
  z-index: 999;
  box-shadow: 0 1px 1px rgba(0, 0, 0, 0.1);
  transition: transform 0.3s ease;
}

.menu-sticky nav {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 0 20px;
}

.menu-sticky nav ul {
  display: flex;
  gap: 20px;
  list-style: none;
  margin: 0;
  padding: 0;
}

.menu-sticky nav ul li a {
  position: relative;
  display: inline-block;
  padding: 0 !important;
  margin: 15px 0 !important;
  text-decoration: none;
}

.menu-sticky nav ul li.current-menu-item a::after,
.menu-sticky nav ul li.current_page_item a::after {
  content: '';
  position: absolute;
  left: 0;
  bottom: -15px;
  width: 100%;
  height: 2px;
  background-color: black;
}

@media screen and (max-width: 1024px) {
  .menu-sticky nav ul { gap: 20px; }
  .menu-sticky nav ul li { padding: 0; }
}

@media screen and (min-width: 1024px) {
  .menu-sticky nav ul { gap: 20px; }
}

@media screen and (max-width: 768px) {
	.header-fixe { box-shadow: 0 1px 1px rgba(0, 0, 0, 0.1);}
}

.menu-sticky nav ul li {
  padding: 0 20px;
  cursor: pointer;
  transition: background 0.3s;
  position: relative;
}

.menu-sticky nav ul li:hover {
  /*background: #f0f0f0;*/
}

.menu-sticky nav ul li::after {
  content: "";
  position: absolute;
  left: 0;
  bottom: 10px;
  height: 2px;
  width: 0%;
  background-color: black;
  transition: width 0.3s ease;
}

.menu-sticky nav ul li:hover::after {
  width: 100%;
}
</style>

<script>
let lastScrollTop = 0;
const header = document.querySelector(".header-fixe");
const stickyMenu = document.querySelector(".menu-sticky");

window.addEventListener("scroll", function () {
  const currentScroll = window.scrollY || document.documentElement.scrollTop;

  if (!header || !stickyMenu) return;

  // Scroll vers le bas → cacher menu + ombre sur header
  if (currentScroll > lastScrollTop && currentScroll > 80) {
    stickyMenu.style.transform = "translateY(-100%)";
    header.classList.add("scrolled");
  }
  // Scroll vers le haut → montrer menu + enlever ombre immédiatement
  else if (currentScroll < lastScrollTop) {
    stickyMenu.style.transform = "translateY(0)";
    header.classList.remove("scrolled");
  }

  lastScrollTop = currentScroll <= 0 ? 0 : currentScroll;
});
</script>


</body>
</html>
