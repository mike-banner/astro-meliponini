    <script>
    document.addEventListener('DOMContentLoaded', function () {
        const observer = new MutationObserver(() => {
            const footerButtons = document.querySelector('.elementor-menu-cart__footer-buttons');
            if (footerButtons && !document.querySelector('.custom-close-button')) {
                const closeBtn = document.createElement('a');
                closeBtn.href = '#';
                closeBtn.className =
                    'elementor-menu-cart__toggle_button elementor-button elementor-size-md close-mini-cart custom-close-button';
                closeBtn.innerHTML =
                    '<span class="elementor-button-text">Retour aux achats</span>';
                closeBtn.addEventListener('click', function (e) {
                    e.preventDefault();
                    const toggleBtn = document.querySelector('#elementor-menu-cart__toggle_button');
                    if (toggleBtn) toggleBtn.click();
                });
                footerButtons.appendChild(closeBtn);
            }
        });
        observer.observe(document.body, { childList: true, subtree: true });
    });
    </script>
        <script type="text/javascript">
        var custom_mini_cart_params = {
            ajax_url: 'https://meliponini.remyparis.com/wp-admin/admin-ajax.php',
            checkout_url: 'https://meliponini.remyparis.com/commander/',
            nonce: '137cd961f9'
        };
    </script>
        <script type="text/javascript">
        document.addEventListener("DOMContentLoaded", function() {
            const paragraph = document.querySelector('.scroll-color-change p');

            const options = {
                root: null,
                rootMargin: '0px',
                threshold: buildThresholdList()
            };

            const callback = (entries, observer) => {
                entries.forEach(entry => {
                    const visibilityRatio = entry.intersectionRatio;
                    const startColor = [0, 0, 0]; // Noir
                    const endColor = [255, 0, 0]; // Rouge
                    const currentColor = startColor.map((channel, index) => {
                        return Math.round(channel + (endColor[index] - channel) * visibilityRatio);
                    });
                    paragraph.style.color = `rgb(${currentColor.join(',')})`;
                });
            };

            const observer = new IntersectionObserver(callback, options);
            observer.observe(paragraph);

            function buildThresholdList() {
                let thresholds = [];
                for (let i = 0; i <= 1.0; i += 0.01) {
                    thresholds.push(i);
                }
                return thresholds;
            }
        });
    </script>
    			<script>
				const lazyloadRunObserver = () => {
					const lazyloadBackgrounds = document.querySelectorAll( `.e-con.e-parent:not(.e-lazyloaded)` );
					const lazyloadBackgroundObserver = new IntersectionObserver( ( entries ) => {
						entries.forEach( ( entry ) => {
							if ( entry.isIntersecting ) {
								let lazyloadBackground = entry.target;
								if( lazyloadBackground ) {
									lazyloadBackground.classList.add( 'e-lazyloaded' );
								}
								lazyloadBackgroundObserver.unobserve( entry.target );
							}
						});
					}, { rootMargin: '200px 0px 200px 0px' } );
					lazyloadBackgrounds.forEach( ( lazyloadBackground ) => {
						lazyloadBackgroundObserver.observe( lazyloadBackground );
					} );
				};
				const events = [
					'DOMContentLoaded',
					'elementor/lazyload/observe',
				];
				events.forEach( ( event ) => {
					document.addEventListener( event, lazyloadRunObserver );
				} );
			</script>
