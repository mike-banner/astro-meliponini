<link rel='stylesheet' id='xoo-wl-style-css' href='https://meliponini.remyparis.com/wp-content/plugins/waitlist-woocommerce/assets/css/xoo-wl-style.css?ver=2.8.4' media='all' />
<style id='xoo-wl-style-inline-css'>

			button.xoo-wl-action-btn{
				background-color: #be1010;
				color: #fff;
				padding: 17px;
			}
			button.xoo-wl-submit-btn{
				max-width: 300px;
			}
			button.xoo-wl-open-form-btn{
				max-width: 300px;
			}
			.xoo-wl-inmodal{
				max-width: 700px;
				max-height: 450px;
			}
		
				.xoo-wl-modal:before {
				    content: '';
				    display: inline-block;
				    height: 100%;
				    vertical-align: middle;
				    margin-right: -0.25em;
				}
			
				.xoo-wl-inmodal{
					display: inline-flex;
					max-height: 90%;
					height: auto;
				}

				.xoo-wl-sidebar, .xoo-wl-wrap{
					height: auto;
				}
			
/*# sourceURL=xoo-wl-style-inline-css */
</style>
