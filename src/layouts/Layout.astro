---
// src/layouts/Layout.astro
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/fonts.css";
import "../styles/global.css";
import "../styles/products-grid.css";
import "../styles/off-canvas.css";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Meliponini — miels rares" } = Astro.props;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Fonts -->
    <link
      rel="preload"
      href="/fonts/abchanelcorpo-regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <!-- SEO global -->
    <link rel="canonical" href={Astro.url.href} />
    <meta property="og:site_name" content="Meliponini" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={Astro.url.href} />

    <link rel="icon" href="/favicon.svg" />

    <script
      src="https://code.iconify.design/iconify-icon/2.1.0/iconify-icon.min.js"
    ></script>

    <slot name="head" />
  </head>

  <body>
    <Header />
    <div id="page-root">
      <slot />
    </div>
    <Footer />
  </body>
</html>
