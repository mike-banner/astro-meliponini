---
// src/layouts/Layout.astro
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Meliponini — miels rares" } = Astro.props;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Fonts -->
    <link
      rel="preload"
      href="/fonts/abchanelcorpo-regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="stylesheet" href="/src/styles/fonts.css" />

    <!-- Global CSS -->
    <link rel="stylesheet" href="/src/styles/global.css" />
    <link rel="stylesheet" href="/src/styles/products-grid.css" />
    <link rel="stylesheet" href="/src/styles/product-card.css" />

    <!-- SEO global -->
    <link rel="canonical" href={Astro.url.href} />
    <meta property="og:site_name" content="Meliponini" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={Astro.url.href} />

    <link rel="icon" href="/favicon.svg" />

    <slot name="head" />
  </head>

  <body>
    <Header />
    <div id="page-root">
      <slot />
    </div>
    <Footer />
  </body>
</html>
