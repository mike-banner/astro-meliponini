---
// src/layouts/Layout.astro
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

import "../styles/products-grid.css";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "A minimalist Astro site." } = Astro.props;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <!-- Slot SEO pages -->
    <slot name="head" />
  </head>

  <body>
    <Header />
    <slot />
    <Footer />
  </body>
</html>

<style is:global>
  html,
  body {
    font-family: system-ui, sans-serif;
    margin: 0;
    padding: 0;
    background-color: #f6f6f6;
    color: #111;
  }

  code {
    font-family:
      Menlo,
      Monaco,
      Lucida Console,
      Liberation Mono,
      DejaVu Sans Mono,
      Bitstream Vera Sans Mono,
      Courier New,
      monospace;
  }

  @font-face {
    font-family: "MyFont";
    src: url("/fonts/ABChanelCorpo-Regular.woff2") format("woff2");
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: "MyFont";
    src: url("/fonts/ABChanelCorpo-Medium.woff2") format("woff2");
    font-weight: 500;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: "MyFont";
    src: url("/fonts/ABChanelCorpo-Bold.woff2") format("woff2");
    font-weight: 700;
    font-style: normal;
    font-display: swap;
  }

  html,
  body {
    font-family: "MyFont", system-ui, sans-serif;
  }

  body {
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }

  h1,
  h2,
  h3,
  strong,
  b {
    font-weight: 400;
    letter-spacing: 0.02em;
  }
</style>
