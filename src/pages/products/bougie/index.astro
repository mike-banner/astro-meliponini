---
/* ROUTE : /products/bougie */

import Layout from "../../../layouts/Layout.astro";
import ProductsGrid from "../../../components/ProductsGrid.astro";
import ProductsFilters from "../../../components/ProductsFilters.astro";
import Breadcrumbs from "../../../components/seo/Breadcrumbs.astro";
import {
    getProductsByCategory,
    getProductCategoriesByParent,
} from "../../../lib/woocommerce.js";

/* ID Woo — catégorie BOUGIE */
const BOUGIE_CATEGORY_ID = 97;

/* Produits BOUGIE */
const products = await getProductsByCategory("bougie");

/* Sous-catégories BOUGIE */
const subCategories = await getProductCategoriesByParent(BOUGIE_CATEGORY_ID);

/* Filtres */
const filters = [
    { label: "Tous", href: "/products/bougie", slug: "all" },
    ...subCategories.map((cat) => ({
        label: cat.name,
        href: `/products/bougie/${cat.slug}`,
        slug: cat.slug,
    })),
];
---

<Layout
    title="Bougie artisanale — Meliponini"
    description="Découvrez nos bougies artisanales, créations premium inspirées de la nature et du savoir-faire Meliponini."
>
    <main class="products-page">
        <Breadcrumbs
            items={[
                { label: "Accueil", url: "/" },
                { label: "Produits", url: "/products" },
                { label: "Bougie", url: "/products/bougie" },
            ]}
        />

        <ProductsFilters filters={filters} active="all" />

        {
            products.length > 0 ? (
                <ProductsGrid products={products} title="Bougie" />
            ) : (
                <section class="products-empty">
                    <p>Nos créations en bougie seront bientôt disponibles.</p>
                </section>
            )
        }
    </main>
</Layout>

<style>
    .products-empty {
        min-height: 40vh;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
    }

    .products-empty p {
        font-size: 0.85rem;
        letter-spacing: 0.06em;
        opacity: 0.7;
    }
</style>
