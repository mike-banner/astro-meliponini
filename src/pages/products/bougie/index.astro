---
/* ROUTE : /products/bougie */

import Layout from "../../../layouts/Layout.astro";
import ProductsGrid from "../../../components/ProductsGrid.astro";
import ProductsFilters from "../../../components/ProductsFilters.astro";
import {
    getProductsByCategory,
    getProductCategoriesByParent,
} from "../../../lib/woocommerce.js";

/* ID Woo — catégorie BOUGIES */
const bougie_CATEGORY_ID = 97;

/* Produits bougie */
const products = await getProductsByCategory("bougie");

/* Sous-catégories bougie */
const subCategories = await getProductCategoriesByParent(bougie_CATEGORY_ID);

/* Filtres */
const filters = [
    { label: "Tous", href: "/products/bougie", slug: "all" },
    ...subCategories.map((cat) => ({
        label: cat.name,
        href: `/products/bougie/${cat.slug}`,
        slug: cat.slug,
    })),
];
---

<Layout title="Les bougie — Meliponini">
    <main class="products-page">
        <ProductsFilters filters={filters} active="all" />

        {
            products.length > 0 ? (
                <ProductsGrid products={products} title="Les bougie" />
            ) : (
                <section class="products-empty">
                    <p>Nos créations en bougie seront bientôt disponibles.</p>
                </section>
            )
        }
    </main>
</Layout>

<style>
    /* =========================
   ÉTAT VIDE — PREMIUM
========================= */
    .products-empty {
        min-height: 40vh;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
    }

    .products-empty p {
        font-size: 0.85rem;
        letter-spacing: 0.06em;
        opacity: 0.7;
    }
</style>
