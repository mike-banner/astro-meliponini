---
/* ROUTE : /products/miel/[slug] */

import Layout from "../../../layouts/Layout.astro";
import ProductsGrid from "../../../components/ProductsGrid.astro";
import Breadcrumbs from "../../../components/seo/Breadcrumbs.astro";
import {
    getProductsByCategory,
    getProductCategoriesByParent,
} from "../../../lib/woocommerce.js";

/* =========================
   ROUTES DYNAMIQUES
========================= */
export async function getStaticPaths() {
    const MIEL_CATEGORY_ID = 96; // ID Woo — MIEL

    const categories = await getProductCategoriesByParent(MIEL_CATEGORY_ID);

    return categories.map((cat) => ({
        params: { slug: cat.slug },
        props: {
            category: cat,
        },
    }));
}

/* =========================
   DONNÉES PAGE
========================= */
const { category } = Astro.props;
const products = await getProductsByCategory(category.slug);
---

<Layout
    title={`Miel ${category.name} — Meliponini`}
    description={`Explorez nos miels ${category.name}, sélection artisanale Meliponini aux arômes uniques.`}
>
    <main class="products-page">
        <Breadcrumbs
            items={[
                { label: "Accueil", url: "/" },
                { label: "Produits", url: "/products" },
                { label: "Miel", url: "/products/miel" },
                {
                    label: category.name,
                    url: `/products/miel/${category.slug}`,
                },
            ]}
        />

        <ProductsGrid products={products} title={`Miel ${category.name}`} />
    </main>
</Layout>
