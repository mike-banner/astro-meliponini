---
/* ROUTE : /products/miel */

import Layout from "../../../layouts/Layout.astro";
import ProductsGrid from "../../../components/ProductsGrid.astro";
import ProductsFilters from "../../../components/ProductsFilters.astro";
import Breadcrumbs from "../../../components/seo/Breadcrumbs.astro";
import {
    getProductsByCategory,
    getProductCategoriesByParent,
} from "../../../lib/woocommerce.js";

/* ID Woo — catégorie MIEL */
const MIEL_CATEGORY_ID = 96;

/* Produits MIEL */
const products = await getProductsByCategory("miel");

/* Sous-catégories (espèces) */
const subCategories = await getProductCategoriesByParent(MIEL_CATEGORY_ID);

/* Filtres automatiques */
const filters = [
    { label: "Tous", href: "/products/miel", slug: "all" },
    ...subCategories.map((cat) => ({
        label: cat.name,
        href: `/products/miel/${cat.slug}`,
        slug: cat.slug,
    })),
];
---

<Layout
    title="Miel artisanal — Meliponini"
    description="Découvrez nos miels artisanaux d’exception, issus de différentes espèces et terroirs sélectionnés."
>
    <main class="products-page">
        <Breadcrumbs
            items={[
                { label: "Accueil", url: "/" },
                { label: "Produits", url: "/products" },
                { label: "Miel", url: "/products/miel" },
            ]}
        />

        <ProductsFilters filters={filters} active="all" />

        {
            products.length > 0 ? (
                <ProductsGrid products={products} title="Miel" />
            ) : (
                <section class="products-empty">
                    <p>Nos miels seront bientôt disponibles.</p>
                </section>
            )
        }
    </main>
</Layout>

<style>
    .products-empty {
        min-height: 40vh;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
    }

    .products-empty p {
        font-size: 0.85rem;
        letter-spacing: 0.06em;
        opacity: 0.7;
    }
</style>
