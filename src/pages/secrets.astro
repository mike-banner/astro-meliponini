---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Les Secrets — Meliponini">
    <main class="page-empty">
        <section class="content-empty">
            <p>
                Les secrets des miels enzymatiques seront bientôt disponibles.
            </p>
        </section>
    </main>
</Layout>

<style>
    .page-empty {
        padding-top: var(--header-height);
        min-height: 60vh;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
    }

    .content-empty p {
        font-size: 0.95rem;
        letter-spacing: 0.06em;
        opacity: 0.7;
    }
</style>
