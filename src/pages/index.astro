---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import { Button } from "@/components/ui/button";
import { FaqSection } from "../components/FaqSection";

const homeFaqItems = [
  {
    question: "Qu'est-ce que le miel de Mélipone ?",
    answer:
      "Le miel de Mélipone est produit par des abeilles sans dard (méliponines) originaires des régions tropicales. Contrairement au miel classique, il est plus liquide, possède une acidité unique et une concentration en enzymes et antioxydants beaucoup plus élevée.",
  },
  {
    question: "Pourquoi est-il considéré comme un miel médicinal ?",
    answer:
      "Grâce à sa teneur exceptionnelle en tréhalulose (un sucre à faible indice glycémique) et à ses propriétés antibactériennes naturelles, il est utilisé depuis des millénaires pour traiter les infections oculaires, respiratoires et renforcer le système immunitaire.",
  },
  {
    question: "Quel goût a le miel de Mélipone ?",
    answer:
      "C'est une expérience sensorielle rare : un équilibre parfait entre une douceur florale subtile et une acidité citronnée rafraîchissante. Sa texture fluide permet aux arômes de se libérer instantanément en bouche.",
  },
  {
    question: "Comment doit-on le conserver ?",
    answer:
      "En raison de son taux d'humidité naturel élevé (environ 25-30%), il est recommandé de le conserver au frais après ouverture pour préserver ses propriétés enzymatiques vivantes et éviter la fermentation.",
  },
  {
    question: "Pourquoi ce miel est-il si rare et précieux ?",
    answer:
      "Une ruche de Mélipones ne produit que 1 à 2 litres de miel par an, contre 30 à 50 litres pour une ruche classique (Apis Mellifera). Chaque goutte est le résultat d'un travail d'orfèvre de la part des abeilles et des producteurs.",
  },
];
---

<Layout title="Meliponini — Miels rares">
  <main class="page-default">
    <!-- =========================
         HERO 1 — LCP (OPTIMISÉ)
    ========================= -->
    <a href="/products/miel" data-astro-prefetch class="hero-link">
      <section class="hero hero-1">
        <div class="video-container">
          <video
            autoplay
            muted
            loop
            playsinline
            webkit-playsinline="true"
            disableRemotePlayback
            poster="/videos/abeille-poster.webp"
            preload="auto"
            class="design-video"
          >
            <source src="/videos/abeille-design.mp4" type="video/mp4" />
            <source src="/videos/abeille-design.webm" type="video/webm" />
            Ton navigateur ne supporte pas la lecture de vidéos.
          </video>
        </div>

        <div class="hero-content fade-up">
          <h1>Les miels enzymatiques<br />des mélipones</h1>
          <Button variant="invert" className="max-w-[260px]">
            DÉCOUVRIR NOS ÉLIXIRS
          </Button>
        </div>
      </section>
    </a>

    <!-- =========================
         SCARCITY PROOF
    ========================= -->
    <div class="scarcity-banner fade-up">
      <p>RÉCOLTE ANNUELLE LIMITÉE — SAISON 2026 RESTREINTE.</p>
    </div>

    <!-- =========================
         HERO 2
    ========================= -->
    <a href="/famille" data-astro-prefetch class="hero-link">
      <section class="hero hero-2">
        <div class="hero-content fade-up">
          <h2>L’univers<br />des mélipones</h2>
          <Button variant="invert" className="max-w-[260px]">
            EXPLORER L'UNIVERS
          </Button>
        </div>
      </section>
    </a>

    <!-- =========================
         HERO 3 (LE SECRET)
    ========================= -->
    <a href="/secrets" data-astro-prefetch class="hero-link">
      <section class="hero hero-3 editorial-section">
        <div class="editorial-grid">
          <div class="editorial-image fade-up">
            <img src="/images/miel_secret.png" alt="Le secret du miel enzymatique" />
          </div>
          <div class="editorial-text fade-up">
            <h2>Les secrets<br />des miels enzymatiques</h2>
            <p class="editorial-desc">Un nectar médicinal pur, issu de l'héritage ancestral maya. Une rareté précieuse, fluide et naturellement acide.</p>
            <Button variant="invert" className="max-w-[260px]">
              PERCER LE MYSTÈRE
            </Button>
          </div>
        </div>
      </section>
    </a>

    <!-- =========================
         HERO 4
    ========================= -->
    <a href="/products/bougie" data-astro-prefetch class="hero-link">
      <section class="hero hero-4">
        <div class="hero-content fade-up">
          <h2>Les bougies<br />des mélipones</h2>
          <Button variant="invert" className="max-w-[260px]">
            VOIR LA COLLECTION
          </Button>
        </div>
      </section>
    </a>

    <!-- =========================
         HERO 5
    ========================= -->
    <a href="/contact" data-astro-prefetch class="hero-link">
      <section class="hero hero-5">
        <div class="hero-content fade-up">
          <h2>Suivez-nous</h2>
          <Button variant="invert" className="max-w-[260px]">
            REJOINDRE L'AVENTURE
          </Button>
        </div>
      </section>
    </a>

    <!-- =========================
         FAQ
    ========================= -->
    <FaqSection title="Questions Fréquentes" items={homeFaqItems} client:load />
  </main>
</Layout>
<script>
  document.addEventListener("DOMContentLoaded", () => {
    const video = document.querySelector(".design-video") as HTMLVideoElement;
    if (video) {
      const startVideo = () => {
        video.play().catch((err) => {
          console.warn(
            "Autoplay initial bloqué, en attente d'interaction.",
            err,
          );
          document.addEventListener("touchstart", () => video.play(), {
            once: true,
          });
          document.addEventListener("click", () => video.play(), {
            once: true,
          });
        });
      };

      // Supprime le poster dès que la vidéo commence vraiment à jouer
      video.addEventListener("playing", () => {
        video.removeAttribute("poster");
      });

      // Retente à chaque étape de chargement disponible (couvre les cas où
      // "loadedmetadata" ne suffit pas sur certains Android/iOS lents)
      video.addEventListener("loadedmetadata", startVideo);
      video.addEventListener("canplay", startVideo, { once: true });
      video.addEventListener("canplaythrough", startVideo, { once: true });

      // Reprend la lecture si l'onglet revient au premier plan
      // (Safari iOS suspend parfois la vidéo en arrière-plan)
      document.addEventListener("visibilitychange", () => {
        if (document.visibilityState === "visible" && video.paused) {
          startVideo();
        }
      });

      // Tentative immédiate + sécurité si déjà chargé
      startVideo();
      if (video.readyState >= 2) {
        startVideo();
      }
    }

    // --- INTERSECTION OBSERVER POUR ANIMATIONS ---
    const observerOptions = {
      root: null,
      rootMargin: "0px",
      threshold: 0.15
    };

    const observer = new IntersectionObserver((entries, observer) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add("visible");
          observer.unobserve(entry.target);
        }
      });
    }, observerOptions);

    document.querySelectorAll(".fade-up").forEach(el => {
      observer.observe(el);
    });
  });
</script>

<style>
  /* =========================
   STRUCTURE GÉNÉRALE
========================= */

  .page-default {
    margin-top: var(--header-height);
  }

  .hero {
    width: 100%;
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    padding-bottom: 5vh;
    background-size: cover;
    background-position: center;
  }

  .hero::before {
    content: "";
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.3);
  }

  .hero-content {
    position: relative;
    text-align: center;
    max-width: 90%;
    padding: 20px;
    color: #fff;
  }

  /* =========================
   HERO 1 — LCP
========================= */
  .hero-1 {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    align-items: center;
    padding-top: 2rem;
    background: #fafafa; /* ✅ Gris très clair */
    margin-top: 0;
    gap: 2rem;
  }

  /* Lien global Hero 1 */
  .hero-link {
    display: block;
    text-decoration: none;
    color: inherit;
    background: #fff; /* ✅ Force le blanc aussi ici */
  }

  .hero-1::before {
    display: none;
  }

  .hero-1 .hero-content {
    color: #000;
  }

  .video-container {
    position: relative;
    width: 50%;
    aspect-ratio: 19 / 9; /* Ratio standard pour limiter le rognage */
    overflow: hidden;
    background: #fafafa;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-top: 2rem;
  }

  .design-video {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover; /* On utilise cover pour masquer les lignes noires */
    transform: scale(1.02); /* Petit zoom de sécurité pour les bordures */
    background: #fafafa;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  .hero-1 .hero-content {
    position: relative;
    color: #000;
    margin-top: 0;
    padding-bottom: 4rem;
  }

  /* =========================
   AUTRES HEROS
========================= */
  .hero-2,
  .hero-3,
  .hero-4,
  .hero-5,
  .hero-6 {
    min-height: 80vh;
  }

  .hero-2 {
    background-image: url("/images/home-1.jpg");
  }
  .hero-4 {
    background-image: url("/images/home-2.jpg");
  }
  .hero-5 {
    background-image: url("/images/home-3.jpg");
  }

  /* =========================
   SCARCITY BANNER
========================= */
  .scarcity-banner {
    width: 100%;
    padding: 2rem 1rem;
    text-align: center;
    background-color: #000;
    color: #fff;
    font-size: 0.85rem;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    border-top: 1px solid #333;
    border-bottom: 1px solid #333;
  }

  /* =========================
   EDITORIAL SECTION (HERO 3)
========================= */
  .editorial-section {
    min-height: auto;
    padding: 8vh 5%;
    background: #fafafa;
    align-items: center;
    justify-content: center;
  }
  .editorial-section::before {
    display: none;
  }
  
  .editorial-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    max-width: 1200px;
    width: 100%;
    align-items: center;
  }

  .editorial-image img {
    width: 100%;
    height: auto;
    object-fit: cover;
    aspect-ratio: 4/5;
    box-shadow: 0 20px 40px rgba(0,0,0,0.1);
  }

  .editorial-text {
    text-align: left;
    color: #000;
  }
  
  .editorial-text h2 {
    color: #000;
    margin-bottom: 1rem;
  }

  .editorial-desc {
    font-size: 1.1rem;
    line-height: 1.6;
    margin-bottom: 2rem;
    color: #333;
    letter-spacing: 0.02em;
  }


  /* =========================
   TYPO
========================= */
  .hero-content h1 {
    font-size: clamp(1.2rem, 4.5vw, 2.5rem);
    font-weight: 400;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-bottom: 1.5rem;
  }

  .hero-content h2 {
    font-size: clamp(1.1rem, 4vw, 2.2rem);
    font-weight: 400;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 1.5rem;
  }

  /* =========================
   TABLETTE
========================= */
  @media (max-width: 768px) {
    .hero-1 {
      min-height: calc(100vh - var(--header-height));
      justify-content: center;
      padding-top: 0;
      margin-top: calc(-1 * var(--header-height) - 20px);
    }

    .hero-1 .hero-content {
      padding-top: 0vh;
    }

    .hero-1 {
      padding-bottom: 3rem;
    }

    .video-container {
      width: 85%;
      aspect-ratio: 18 / 9;
    }
    
    .editorial-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    
    .editorial-text {
      text-align: center;
    }
  }

  /* =============== */
</style>
