---
/* ROUTE : / */

import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
---

<Layout title="Meliponini — Miels rares">
  <main class="page-default">
    <!-- =========================
         HERO 1 — LCP (OPTIMISÉ)
    ========================= -->
    <a href="/products/miel" data-astro-prefetch class="hero-link">
      <section class="hero hero-1">
        <div class="video-container">
          <video 
            autoplay 
            muted 
            loop 
            playsinline 
            poster="/videos/abeille-poster.webp"
            preload="metadata"
            class="design-video"
          >
            <source src="/videos/abeille-design.mp4" type="video/mp4" />
            <source src="/videos/abeille-design.webm" type="video/webm" />
            Ton navigateur ne supporte pas la lecture de vidéos.
          </video>
        </div>

        <div class="hero-content">
          <h1>Les miels enzymatiques<br />des mélipones</h1>
          <span class="hero-btn">VOIR PLUS</span>
        </div>
      </section>
    </a>

    <!-- =========================
         HERO 2
    ========================= -->
    <a href="/famille" data-astro-prefetch class="hero-link">
      <section class="hero hero-2">
        <div class="hero-content">
          <h2>L’univers<br />des mélipones</h2>
          <span class="hero-btn">VOIR PLUS</span>
        </div>
      </section>
    </a>

    <!-- =========================
         HERO 3
    ========================= -->
    <a href="/secrets" data-astro-prefetch class="hero-link">
      <section class="hero hero-3">
        <div class="hero-content">
          <h2>Les secrets<br />des miels enzymatiques</h2>
          <span class="hero-btn">VOIR PLUS</span>
        </div>
      </section>
    </a>

    <!-- =========================
         HERO 4
    ========================= -->
    <a href="/products/bougie" data-astro-prefetch class="hero-link">
      <section class="hero hero-4">
        <div class="hero-content">
          <h2>Les bougies<br />des mélipones</h2>
          <span class="hero-btn">VOIR PLUS</span>
        </div>
      </section>
    </a>

    <!-- =========================
         HERO 5
    ========================= -->
    <a href="/contact" data-astro-prefetch class="hero-link">
      <section class="hero hero-5">
        <div class="hero-content">
          <h2>Suivez-nous</h2>
          <span class="hero-btn">VOIR PLUS</span>
        </div>
      </section>
    </a>

    <!-- =========================
         HERO 6
    ========================= -->
    <section class="hero hero-6">
      <div class="hero-content">
        <h2>Meliponini</h2>
      </div>
    </section>
  </main>
</Layout>
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const video = document.querySelector('.design-video') as HTMLVideoElement;
    if (video) {
      const startVideo = () => {
        video.play().catch(err => {
          console.warn("Autoplay initial bloqué, en attente d'interaction.", err);
          document.addEventListener('touchstart', () => video.play(), { once: true });
          document.addEventListener('click', () => video.play(), { once: true });
        });
      };

      // Supprime le poster dès que la vidéo commence vraiment à jouer
      video.addEventListener('playing', () => {
        video.removeAttribute('poster');
      });

      // Tente de jouer dès que les métadonnées sont là
      video.addEventListener('loadedmetadata', startVideo);
      
      // Sécurité si déjà chargé
      if (video.readyState >= 2) {
        startVideo();
      }
    }
  });
</script>

<style>
/* =========================
   STRUCTURE GÉNÉRALE
========================= */

.page-default {
    margin-top: var(--header-height);
}

.hero {
  width: 100%;
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  padding-bottom: 5vh;
  background-size: cover;
  background-position: center;
}

.hero::before {
  content: "";
  position: absolute;
  inset: 0;
  background: rgba(0, 0, 0, 0.3);
}

.hero-content {
  position: relative;
  text-align: center;
  max-width: 90%;
  padding: 20px;
  color: #fff;
}

/* =========================
   HERO 1 — LCP
========================= */
.hero-1 {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
  align-items: center;
  padding-top: 2rem;
  background: #FAFAFA; /* ✅ Gris très clair */
  margin-top: 0;
  gap: 2rem;
}

/* Lien global Hero 1 */
.hero-link {
  display: block;
  text-decoration: none;
  color: inherit;
  background: #fff; /* ✅ Force le blanc aussi ici */
}

.hero-link:hover .hero-btn {
  transform: translateY(-1px);
  box-shadow: 0 6px 16px rgba(0, 0, 0, 0.25);
}

.hero-1::before {
  display: none;
}

.hero-1 .hero-content {
  color: #000;
}

.video-container {
  position: relative;
  width: 50%;
  aspect-ratio: 19 / 9; /* Ratio standard pour limiter le rognage */
  overflow: hidden;
  background: #FAFAFA;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 2rem;
}

.design-video {
  width: 100%;
  height: 100%;
  display: block;
  object-fit: cover; /* On utilise cover pour masquer les lignes noires */
  transform: scale(1.02); /* Petit zoom de sécurité pour les bordures */
  background: #FAFAFA;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

.hero-1 .hero-content {
  position: relative;
  color: #000;
  margin-top: 0;
  padding-bottom: 4rem;
}

/* =========================
   AUTRES HEROS
========================= */
.hero-2,
.hero-3,
.hero-4,
.hero-5,
.hero-6 {
  min-height: 80vh;
}

.hero-2 {
  background-image: url("/images/home-1.jpg");
}
.hero-4 {
  background-image: url("/images/home-2.jpg");
}
.hero-5 {
  background-image: url("/images/home-3.jpg");
}

/* =========================
   TYPO
========================= */
.hero-content h1 {
  font-size: clamp(1rem, 3.5vw, 1.8rem);
  font-weight: 400;
  margin-bottom: 1.5rem;
}

.hero-content h2 {
  font-size: clamp(1.1rem, 3.5vw, 2rem);
  font-weight: 400;
  margin-bottom: 1.5rem;
}

/* =========================
   BOUTON
========================= */
.hero-btn {
  display: inline-block;
  background: #fff;
  color: #000;
  padding: 16px 22px;
  text-decoration: none;
  font-weight: 400;
  font-size: 0.95rem;
  border: 1px solid #000;
  border-radius: 5%; /* ✅ Border radius */
  transition: transform 160ms ease, box-shadow 160ms ease;
}

.hero-btn:hover {
  transform: translateY(-1px);
  box-shadow: 0 6px 16px rgba(0, 0, 0, 0.25);
}

/* =========================
   TABLETTE
========================= */
@media (max-width: 768px) {
  .hero-1 {
    min-height: 20vh;
    /* ✅ CORRECTION : restaurer le margin pour éviter que le contenu passe sous le header */
    margin-top: var(--header-height);
  }

  .hero-1 .hero-content {
    padding-top: 0vh;
  }

  .hero-1 {
    min-height: auto;
    padding-bottom: 3rem;
  }

  .video-container {
    width: 85%;
    aspect-ratio: 18 / 9;
  }

  .hero-btn {
    font-size: 0.85rem;
    padding: 14px 8px;
  }
}

/* ===============*
