---
interface Props {
    isActive: (path: string) => boolean;
    from: string | null;
}

const { isActive, from } = Astro.props;
---

<button class="burger" aria-label="Menu" id="menuButton">
    <iconify-icon icon="material-symbols-light:menu-rounded"></iconify-icon>
</button>

<div class="offcanvas">
    <nav>
        <a
            href="/products"
            class={isActive("/products") ? "active" : ""}
            data-astro-prefetch>Tous les produits</a
        >
        <a
            href="/products/miel"
            class={isActive("/products/miel") ? "active" : ""}
            data-astro-prefetch>Miel</a
        >
        <a
            href="/products/bougie"
            class={isActive("/products/bougie") ? "active" : ""}
            data-astro-prefetch>Bougie</a
        >
        <a
            href="/famille"
            class={isActive("/famille") ? "active" : ""}
            data-astro-prefetch>Familles</a
        >
        <a
            href="/le-secret-des-miels-enzimatiques"
            class={isActive("/le-secret-des-miels-enzimatiques")
                ? "active"
                : ""}
            data-astro-prefetch>Le Secret des miels enzymatiques</a
        >

        {
            from === "shop" && (
                <a
                    href="https://dev-shop.meliponini.fr/checkout/"
                    class="shop-btn"
                >
                    Retourner à la boutique
                </a>
            )
        }
    </nav>
</div>

<div class="offcanvas-overlay"></div>

<script>
    const menuButton = document.getElementById("menuButton");
    const menuOffcanvas = document.querySelector(".offcanvas");
    const menuOverlay = document.querySelector(".offcanvas-overlay");

    if (menuButton && menuOffcanvas && menuOverlay) {
        menuButton.addEventListener("click", () => {
            menuOffcanvas.classList.toggle("open");
            menuOverlay.classList.toggle("open");
            document.body.classList.toggle("elementor-offcanvas-active");
        });

        const closeMenu = () => {
            menuOffcanvas.classList.remove("open");
            menuOverlay.classList.remove("open");
            document.body.classList.remove("elementor-offcanvas-active");
        };

        menuOverlay.addEventListener("click", closeMenu);
        menuOffcanvas.querySelectorAll("nav a").forEach((link) => {
            link.addEventListener("click", closeMenu);
        });
    }
</script>

<style>
    .burger {
        position: absolute;
        left: 20px;
        top: 50%;
        transform: translateY(-50%) !important;
        background: none;
        border: none;
        cursor: pointer;
        display: none;
        color: #000;
        padding: 0;
        align-items: center;
        justify-content: center;
        z-index: 10001;
        min-width: 44px;
        min-height: 44px;
    }

    .burger iconify-icon {
        font-size: 32px;
    }

    @media (max-width: 600px) {
        .burger {
            display: flex;
        }
    }

    .offcanvas,
    .offcanvas-overlay {
        display: none;
    }

    .offcanvas {
        position: fixed;
        top: var(--header-height);
        left: 0;
        width: 60vw;
        max-width: 320px;
        height: calc(100vh - var(--header-height));
        background: #fff;
        padding: 2.5rem 1.5rem;
        transform: translateX(-100%);
        transition: transform 0.45s cubic-bezier(0.25, 0.8, 0.25, 1);
        z-index: 1000;
        box-shadow: var(--shadow-subheader);
    }

    .offcanvas.open {
        transform: translateX(0);
    }

    .offcanvas nav {
        display: flex;
        flex-direction: column;
        gap: 1.6rem;
    }

    .offcanvas nav a {
        position: relative;
        text-decoration: none;
        color: #000;
        font-size: 0.9rem;
    }

    .offcanvas nav a::after {
        content: "";
        position: absolute;
        left: 0;
        bottom: -4px;
        width: 100%;
        height: 1px;
        background: currentColor;
        transform: scaleX(0);
        transform-origin: left;
        transition: transform 0.25s ease;
    }

    .offcanvas nav a.active {
        color: #999;
    }

    .offcanvas nav a:hover::after,
    .offcanvas nav a.active::after {
        transform: scaleX(1);
    }

    .shop-btn {
        border-radius: var(--radius);
        font-weight: 600;
    }

    .offcanvas-overlay {
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.4);
        backdrop-filter: blur(2px);
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.3s ease;
        z-index: 700;
    }

    .offcanvas-overlay.open {
        opacity: 1;
        pointer-events: auto;
    }

    @media (max-width: 600px) {
        .offcanvas,
        .offcanvas-overlay {
            display: block;
        }
    }
</style>
