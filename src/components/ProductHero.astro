---
import { Button } from "@/components/ui/button";

interface Props {
    brand?: string;
    name: string;
    displayName?: string;
    price: string;
    image: string;
    description: string;
    notes?: string[];
    product_id?: string;
    stockStatus?: string;
    stockQuantity?: number | null;
}

const {
    brand = "MELIPONINI",
    name,
    displayName,
    price,
    image,
    description,
    notes = ["Agrumes", "Floral", "Résine"],
    product_id,
    stockStatus = "instock",
    stockQuantity = null,
} = Astro.props;

// Calcul de la disponibilité
const isOutOfStock = stockStatus === "outofstock";
const availabilityLabel = isOutOfStock
    ? "Indisponible"
    : stockQuantity !== null && stockQuantity > 0 && stockQuantity <= 5
      ? "Limitée"
      : "Disponible";
---

<section id="product-hero" class="relative w-full bg-white">
    <div class="grid grid-cols-1 lg:grid-cols-12 pt-10 lg:pt-0">
        <!-- Colonne IMAGE (Gauche - Sticky sur Desktop) -->
        <div
            class="lg:col-span-7 relative bg-[#F9F9F9] flex items-center lg:items-start justify-center p-8 md:p-16 lg:p-20 lg:pt-48 lg:h-screen lg:sticky lg:top-0"
        >
            <div class="absolute top-10 left-10">
                <span
                    class="text-[10px] font-black uppercase tracking-[0.4em] text-gray-400"
                    >{brand}</span
                >
            </div>

            <div
                class="card-photo md:max-w-[450px] w-full aspect-square bg-white rounded-3xl shadow-[0_20px_50px_rgba(0,0,0,0.05)] border border-gray-100 flex items-center justify-center p-12"
            >
                <img
                    src={image}
                    alt={name}
                    class="w-full max-w-[280px] md:max-w-[320px] h-auto object-contain mix-blend-multiply"
                />
            </div>
        </div>

        <!-- Colonne INFOS (Droite - Fixe & Scrollable sur Desktop) -->
        <div
            class="lg:col-span-5 flex flex-col px-8 py-20 md:px-20 lg:px-16 lg:py-32 justify-between lg:h-screen lg:overflow-y-auto bg-white"
        >
            <div class="mt-12">
                <div
                    class="flex items-center gap-4 mb-10 text-[9px] font-bold uppercase tracking-[0.3em]"
                >
                    <span>Miel Enzymatique</span>
                    <span class="w-4 h-[1px] bg-black"></span>
                    <span class="text-gray-400">Rare Edition</span>
                </div>

                <h1
                    class="text-4xl md:text-5xl font-normal uppercase tracking-[0.12em] mb-4 leading-[0.9]"
                >
                    {name}
                </h1>

                <div
                    class="text-[11px] font-black uppercase tracking-[0.3em] text-zinc-400 mb-8"
                >
                    {displayName}
                </div>

                <div class="space-y-6 mb-8">
                    <div class="flex gap-2 flex-wrap">
                        {
                            notes.map((note) => (
                                <span class="px-3 py-1 border border-gray-100 text-[9px] font-black uppercase tracking-widest text-zinc-500">
                                    {note}
                                </span>
                            ))
                        }
                    </div>
                </div>

                <div class="flex flex-col gap-6">
                    <div
                        class="text-2xl font-black tracking-tighter"
                        style="color: hsl(var(--accent-gold));"
                    >
                        {price}
                    </div>

                    <div class="flex">
                        <Button
                            client:load
                            variant={isOutOfStock ? "destructive" : "default"}
                            disabled={isOutOfStock}
                            size="lg"
                            className="add-to-cart-btn-hero w-fit px-10 text-[9px] tracking-[0.3em] disabled:opacity-100"
                            data-product-id={product_id}
                        >
                            {
                                isOutOfStock
                                    ? "BIENTÔT DISPONIBLE"
                                    : "DÉCOUVRIR L'EXPÉRIENCE"
                            }
                        </Button>
                    </div>
                </div>
            </div>

            <!-- Footer infos (5 colonnes pour les métadonnées) -->
            <div
                class="mt-6 pt-8 border-t border-gray-100 grid grid-cols-2 md:grid-cols-3 gap-y-6 gap-x-4"
            >
                <div>
                    <h4
                        class="text-[8px] font-black uppercase tracking-widest text-gray-400 mb-1"
                    >
                        Conservation
                    </h4>
                    <p class="text-[10px] font-bold uppercase italic">
                        Frais requis
                    </p>
                </div>
                <div>
                    <h4
                        class="text-[8px] font-black uppercase tracking-widest text-gray-400 mb-1"
                    >
                        Disponibilité
                    </h4>
                    <p
                        class={`text-[10px] font-bold uppercase italic ${isOutOfStock ? "text-[#be1010]" : ""}`}
                    >
                        {availabilityLabel}
                    </p>
                </div>
                <div>
                    <h4
                        class="text-[8px] font-black uppercase tracking-widest text-gray-400 mb-1"
                    >
                        Couleur
                    </h4>
                    <p class="text-[10px] font-bold uppercase italic">Ambré</p>
                </div>
                <div>
                    <h4
                        class="text-[8px] font-black uppercase tracking-widest text-gray-400 mb-1"
                    >
                        Texture
                    </h4>
                    <p class="text-[10px] font-bold uppercase italic">
                        Liquide
                    </p>
                </div>
                <div class="col-span-2 md:col-span-1">
                    <h4
                        class="text-[8px] font-black uppercase tracking-widest text-gray-400 mb-1"
                    >
                        Saveur, Gout
                    </h4>
                    <p class="text-[10px] font-bold uppercase italic">
                        Floral & Acidulé
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    #product-hero {
        opacity: 0;
        animation: fadeIn 1s ease-out forwards;
    }

    @keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* Cache le header par défaut si on veut un look full page, à ajuster selon le besoin */
</style>
