---
---

<button class="custom-cart-icon" id="cartButton" aria-label="Voir le panier">
    <iconify-icon icon="ph:handbag-light"></iconify-icon>
    <div class="custom-cart-compteur hidden" id="cartCompteur">
        <span class="custom-cart-count" id="cart-count">0</span>
    </div>
</button>

<script>
    import { cartStore, toggleCart } from "../../lib/cartStore.js";

    const cartButton = document.getElementById("cartButton");
    const cartCountEl = document.getElementById("cart-count");
    const cartCompteurEl = document.getElementById("cartCompteur");

    if (cartButton) {
        cartButton.addEventListener("click", (e) => {
            e.preventDefault();
            toggleCart(true);
        });
    }

    cartStore.subscribe((state: any) => {
        if (cartCountEl && cartCompteurEl) {
            cartCountEl.textContent = String(state.totals.count);
            if (state.totals.count > 0) {
                cartCompteurEl.classList.remove("hidden");
                cartCompteurEl.classList.add("visible");
            } else {
                cartCompteurEl.classList.add("hidden");
                cartCompteurEl.classList.remove("visible");
            }
        }
    });
</script>

<style>
    .custom-cart-icon {
        position: absolute;
        right: 60px;
        top: 50%;
        transform: translateY(-50%);
        text-decoration: none;
        display: flex;
        align-items: center;
        z-index: 10000;
        background: none;
        border: none;
        padding: 0;
        cursor: pointer;
        color: #000 !important;
        -webkit-tap-highlight-color: transparent;
        outline: none;
    }

    .custom-cart-icon iconify-icon {
        font-size: 24px;
        vertical-align: middle;
        color: #000 !important;
        display: inline-block;
        transform: scaleX(0.75);
        --iconify-color: #000;
        stroke: #000;
        fill: #000;
    }

    .custom-cart-count {
        display: block;
        line-height: 1;
        white-space: nowrap;
        max-width: 100%;
        text-align: center;
        font-size: 8px;
        color: white;
    }

    .custom-cart-compteur {
        position: absolute;
        top: -10px;
        right: -15px;
        width: 20px;
        height: 20px;
        background: black;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 4px 6px;
        border-radius: 50%;
        font-weight: bold;
    }

    .custom-cart-compteur.hidden {
        display: none !important;
    }

    .custom-cart-compteur.visible {
        display: flex !important;
    }

    @media (max-width: 600px) {
        .custom-cart-icon {
            right: 40px;
        }
    }
</style>
