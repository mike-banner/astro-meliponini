---
/* COMPONENT : ProductsGrid */
import ProductCard from "./ProductCard.astro";

const { products, title } = Astro.props;
---

<!-- =========================
     TOOLBAR (MOBILE)
========================= -->
<div class="products-toolbar">
    <h1 class="visually-hidden">{title}</h1>

    <button
        type="button"
        class="layout-toggle"
        aria-label="Changer l’affichage"
        data-layout-toggle
    >
        <span class="icon-one-wrapper">
            <iconify-icon icon="ph:rows-light" style="font-size: 24px;"
            ></iconify-icon>
        </span>
        <span class="icon-two-wrapper">
            <iconify-icon icon="ph:squares-four-light" style="font-size: 24px;"
            ></iconify-icon>
        </span>
    </button>
</div>

<!-- =========================
     GRID
========================= -->
<section class="products-grid" data-products-grid>
    {products.map((product: any) => <ProductCard product={product} />)}
</section>

<style is:global>
    /* Ralentit la transition globale du navigateur */
    ::view-transition-old(root),
    ::view-transition-new(root) {
        animation-duration: 0.8s;
        animation-timing-function: cubic-bezier(0.65, 0, 0.35, 1);
    }
</style>

<style>
    .products-toolbar h1 {
        letter-spacing: var(--letter-spacing-premium);
        text-transform: uppercase;
        font-weight: 400;
        font-size: clamp(1.4rem, 4vw, 2.4rem);
    }

    .products-toolbar h1:not(.visually-hidden)::after {
        content: "";
        display: block;
        width: 48px;
        height: 2px;
        background: hsl(var(--accent-gold));
        margin: 0.75rem auto 0;
    }
</style>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        const toggle = document.querySelector("[data-layout-toggle]");
        const grid = document.querySelector("[data-products-grid]");

        if (!toggle || !grid) return;

        toggle.addEventListener("click", () => {
            const toggleLayout = () => {
                grid.classList.toggle("row-layout");
                toggle.classList.toggle("is-row");
            };

            // Utilise l'API View Transitions pour un mouvement fluide si supporté
            if ((document as any).startViewTransition) {
                (document as any).startViewTransition(() => toggleLayout());
            } else {
                toggleLayout();
            }
        });
    });
</script>
