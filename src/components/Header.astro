---
/* COMPONENT : Header */
const from = Astro.url.searchParams.get("from");
---

<!-- =========================
     HEADER FIXE
========================= -->
<header class="header-fixe">
    <div class="header-inner">
        <button class="burger" aria-label="Menu">☰</button>
        <a href="/" class="logo" data-astro-prefetch>MELIPONINI</a>
    </div>
</header>

<!-- =========================
     CTA COMMANDE (WOO)
========================= -->
<a href="/checkout" class="resume-order" id="resumeOrder" aria-hidden="true">
    Commander
</a>

<!-- =========================
     OFF-CANVAS MOBILE
========================= -->
<div class="offcanvas">
    <nav>
        <a href="/products" data-astro-prefetch>Tous les produits</a>
        <a href="/products/miel" data-astro-prefetch>Miel</a>
        <a href="/products/bougie" data-astro-prefetch>Bougie</a>

        <a href="/famille" data-astro-prefetch>Familles</a>
        <a href="/secrets" data-astro-prefetch
            >Le Secret des miels enzymatiques</a
        >

        {
            from === "shop" && (
                <a
                    href="https://meliponini.remyparis.com/commander/"
                    class="shop-btn"
                >
                    Retourner à la boutique
                </a>
            )
        }
    </nav>
</div>

<div class="offcanvas-overlay"></div>

<!-- =========================
     MENU DESKTOP
========================= -->

<div class="menu-sticky">
    <nav>
        <ul>
            <li><a href="/products">Tous les produits</a></li>
            <li><a href="/products/miel">Miel</a></li>
            <li><a href="/products/bougie">Bougie</a></li>

            <li><a href="/famille">Familles</a></li>
            <li><a href="/secrets">Le Secret des miels enzymatiques</a></li>
        </ul>

        {
            from === "shop" && (
                <a
                    href="https://meliponini.remyparis.com/commander/"
                    class="shop-btn"
                >
                    Retourner à la boutique
                </a>
            )
        }
    </nav>
</div>

<!-- =========================
     SCRIPT
========================= -->
<script>
    document.addEventListener("DOMContentLoaded", () => {
        const burger = document.querySelector(".burger");
        const offcanvas = document.querySelector(".offcanvas");
        const overlay = document.querySelector(".offcanvas-overlay");

        if (!burger || !offcanvas || !overlay) return;

        const openMenu = () => {
            offcanvas.classList.add("open");
            overlay.classList.add("open");
            document.body.style.overflow = "hidden";
        };

        const closeMenu = () => {
            offcanvas.classList.remove("open");
            overlay.classList.remove("open");
            document.body.style.overflow = "";
        };

        burger.addEventListener("click", (e) => {
            e.preventDefault();
            offcanvas.classList.contains("open") ? closeMenu() : openMenu();
        });

        overlay.addEventListener("click", closeMenu);

        offcanvas.querySelectorAll("a").forEach((link) => {
            link.addEventListener("click", closeMenu);
        });

        /* CTA COMMANDE (COOKIE) */
        const btn = document.getElementById("resumeOrder");
        if (btn && document.cookie.includes("has_active_cart=1")) {
            window.addEventListener("scroll", () => {
                btn.classList.toggle("is-visible", window.scrollY > 120);
            });
        }

        /* GESTION OMBRE HEADER AU SCROLL (REPLI MENU) */
        const header = document.querySelector(".header-fixe");
        /* On prend une valeur proche de la hauteur du menu sticky (~56px) */
        const SCROLL_THRESHOLD = 60;

        if (header) {
            window.addEventListener("scroll", () => {
                const shouldHaveShadow = window.scrollY > SCROLL_THRESHOLD;
                header.classList.toggle("is-scrolled", shouldHaveShadow);
            });
            /* Init au chargement si on est déjà scrollé */
            if (window.scrollY > SCROLL_THRESHOLD) {
                header.classList.add("is-scrolled");
            }
        }
    });
</script>

<style>
    /* =========================
   HEADER FIXE (LOGO UNIFORME)
========================= */
    .header-fixe {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        border-top: 8px solid #000;

        /* 👇 hauteur pilotée par variable */
        height: var(--header-height);

        /* 👇 taille de police fixe pour éviter l'héritage */
        font-size: 16px;

        background: #fff;
        z-index: 1000;

        /* desktop : PAS d’ombre ici */
        box-shadow: none;

        /* Transition pour l'ombre */
        transition: box-shadow 0.3s ease;
    }

    /* Classe ajoutée en JS au scroll */
    .header-fixe.is-scrolled {
        box-shadow: var(--shadow-subheader);
    }

    .header-inner {
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
    }

    /* =========================
   LOGO — VERROUILLAGE ABSOLU
========================= */
    .header-fixe .logo {
        font-family: "abchannel", system-ui, sans-serif;

        /* fluide mais contrôlé */
        font-size: 28px;
        /* stable partout */

        line-height: 1;
        letter-spacing: 0.2em;
        font-weight: 600;

        display: inline-block;
        white-space: nowrap;
    }

    /* =========================
   BURGER
========================= */
    .burger {
        position: absolute;
        left: 20px;
        background: none;
        border: none;
        font-size: 22px;
        cursor: pointer;
        display: none;
        color: #000;
    }

    /* =========================
   SUB HEADER (MENU DESKTOP)
========================= */
    .menu-sticky {
        position: absolute;
        top: var(--header-height);
        left: 0;
        right: 0;
        background: #fff;
        z-index: 900;

        /* 👇 ombre desktop */
        box-shadow: var(--shadow-subheader);
    }

    .menu-sticky nav {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 2.5rem;
    }

    .menu-sticky ul {
        display: flex;
        gap: 1.8rem;
        list-style: none;
        margin: 0;
        padding: 1.4rem 0;
    }

    .menu-sticky ul li a {
        position: relative;
        text-decoration: none;
        color: #000;
        font-size: 0.85rem;
    }

    /* =========================
   SOULIGNEMENT LIENS
========================= */
    .menu-sticky ul li a::after,
    .offcanvas nav a::after {
        content: "";
        position: absolute;
        left: 0;
        bottom: -4px;
        width: 100%;
        height: 1px;
        background: currentColor;
        transform: scaleX(0);
        transform-origin: left;
        transition: transform 0.25s ease;
    }

    .menu-sticky ul li a:hover::after,
    .offcanvas nav a:hover::after {
        transform: scaleX(1);
    }

    /* =========================
   OFF-CANVAS MOBILE (GAUCHE)
========================= */
    .offcanvas,
    .offcanvas-overlay {
        display: none;
    }

    .offcanvas {
        position: fixed;
        top: var(--header-height);
        left: 0;
        width: 70vw;
        max-width: 320px;
        height: calc(100vh - var(--header-height));
        background: #fff;
        padding: 2rem 1.5rem;
        transform: translateX(-100%);
        transition: transform 0.4s ease;
        z-index: 3000;

        border-top-right-radius: 10%;
        box-shadow: var(--shadow-subheader);
    }

    .offcanvas.open {
        transform: translateX(0);
    }

    .offcanvas nav {
        display: flex;
        flex-direction: column;
        gap: 1.6rem;
    }

    .offcanvas nav a {
        position: relative;
        text-decoration: none;
        color: #000;
        font-size: 0.9rem;
    }

    /* =========================
   OVERLAY
========================= */
    .offcanvas-overlay {
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.25);
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.3s ease;
        z-index: 2000;
    }

    .offcanvas-overlay.open {
        opacity: 1;
        pointer-events: auto;
    }

    /* =========================
   MOBILE LARGE + TABLETTE PORTRAIT
========================= */
    @media (max-width: 768px) {
        .menu-sticky nav {
            gap: 1.5rem; /* Réduit l'espace entre les éléments */
        }

        .menu-sticky ul {
            gap: 1.2rem; /* Réduit l'espace entre les liens */
            padding: 1.2rem 1rem; /* Ajoute du padding latéral */
        }

        .menu-sticky ul li a {
            font-size: 0.6rem; /* Légèrement plus petit */
        }
    }

    /* =========================
   MOBILE — CORRECTIONS CIBLÉES
========================= */
    @media (max-width: 600px) {
        /* ❌ SUB MENU DESKTOP */
        .menu-sticky {
            display: none !important;
        }

        .burger {
            display: block;
            top: 50%;
            transform: translateY(-50%);
        }

        .menu-wrapper {
            display: none;
        }

        /* ✅ OMBRE SOUS LE HEADER EN MOBILE */
        .header-fixe {
            box-shadow: var(--shadow-subheader);
        }

        .header-fixe .logo {
            font-size: 20px;
        }

        .offcanvas,
        .offcanvas-overlay {
            display: block;
        }
    }
</style>
