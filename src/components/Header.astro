---
import { CartDrawer } from "./CartDrawer.tsx";
const from = Astro.url.searchParams.get("from");
const currentPath = Astro.url.pathname;
const isActive = (path: string) => {
    const normCurrent =
        currentPath.endsWith("/") && currentPath.length > 1
            ? currentPath.slice(0, -1)
            : currentPath;
    const normPath =
        path.endsWith("/") && path.length > 1 ? path.slice(0, -1) : path;
    if (normCurrent === normPath) return true;
    if (
        normPath === "/secrets" &&
        normCurrent === "/le-secret-des-miels-enzimatiques"
    )
        return true;
    return false;
};
---

<style is:global>
    /* header */
</style>

<!-- =========================
     HEADER FIXE
========================= -->
<header class="header-fixe">
    <div class="header-inner">
        <button class="burger" aria-label="Menu" id="menuButton">
            <iconify-icon icon="material-symbols-light:menu-rounded"
            ></iconify-icon>
        </button>
        <a href="/" class="logo" data-astro-prefetch>MELIPONINI</a>
        <button
            class="custom-cart-icon"
            id="cartButton"
            aria-label="Voir le panier"
        >
            <iconify-icon icon="ph:shopping-bag-light"></iconify-icon>
            <div class="custom-cart-compteur hidden" id="cartCompteur">
                <span class="custom-cart-count" id="cart-count">0</span>
            </div>
        </button>
    </div>
</header>

<!-- =========================
     CTA COMMANDE (WOO)
========================= -->
<a href="/checkout" class="resume-order" id="resumeOrder" aria-hidden="true">
    Commander
</a>

<!-- =========================
     OFF-CANVAS MOBILE (MENU)
========================= -->
<div class="offcanvas">
    <nav>
        <a
            href="/products"
            class={isActive("/products") ? "active" : ""}
            data-astro-prefetch>Tous les produits</a
        >
        <a
            href="/products/miel"
            class={isActive("/products/miel") ? "active" : ""}
            data-astro-prefetch>Miel</a
        >
        <a
            href="/products/bougie"
            class={isActive("/products/bougie") ? "active" : ""}
            data-astro-prefetch>Bougie</a
        >

        <a
            href="/famille"
            class={isActive("/famille") ? "active" : ""}
            data-astro-prefetch>Familles</a
        >
        <a
            href="/le-secret-des-miels-enzimatiques"
            class={isActive("/le-secret-des-miels-enzimatiques")
                ? "active"
                : ""}
            data-astro-prefetch>Le Secret des miels enzymatiques</a
        >

        {
            from === "shop" && (
                <a
                    href="https://dev-shop.meliponini.fr/checkout/"
                    class="shop-btn"
                >
                    Retourner à la boutique
                </a>
            )
        }
    </nav>
</div>

<div class="offcanvas-overlay"></div>

<!-- =========================
     MENU DESKTOP
========================= -->

<div class="menu-sticky">
    <nav>
        <ul>
            <li>
                <a
                    href="/products"
                    class={isActive("/products") ? "active" : ""}
                    >Tous les produits</a
                >
            </li>
            <li>
                <a
                    href="/products/miel"
                    class={isActive("/products/miel") ? "active" : ""}>Miel</a
                >
            </li>
            <li>
                <a
                    href="/products/bougie"
                    class={isActive("/products/bougie") ? "active" : ""}
                    >Bougie</a
                >
            </li>

            <li>
                <a href="/famille" class={isActive("/famille") ? "active" : ""}
                    >Familles</a
                >
            </li>
            <li>
                <a
                    href="/le-secret-des-miels-enzimatiques"
                    class={isActive("/le-secret-des-miels-enzimatiques")
                        ? "active"
                        : ""}>Le Secret des miels enzymatiques</a
                >
            </li>
        </ul>

        {
            from === "shop" && (
                <a
                    href="https://dev-shop.meliponini.fr/checkout/"
                    class="shop-btn"
                >
                    Retourner à la boutique
                </a>
            )
        }
    </nav>
</div>

<!-- =========================
     OFF-CANVAS PANIER (REACT)
========================= -->
<CartDrawer client:load />

<!-- =========================
     SCRIPT
========================= -->
<script>
    import { cartStore, refreshCart, toggleCart } from "../lib/cartStore.js";
    import {
        updateItem,
        removeItem,
        addToCart,
        cartKey,
        getCart,
    } from "../lib/cocart.js";

    document.addEventListener("DOMContentLoaded", () => {
        const cartButton = document.getElementById("cartButton");
        const cartOffcanvas = document.getElementById("cartOffcanvas");
        const cartOverlay = document.getElementById("cartOverlay");
        const miniCartContent = document.getElementById("miniCartContent");

        const cartCountEl = document.getElementById("cart-count");
        const cartCompteurEl = document.getElementById("cartCompteur");
        const resumeOrder = document.getElementById(
            "resumeOrder",
        ) as HTMLAnchorElement;

        // --- GESTION MENU MOBILE ---
        const menuButton = document.getElementById("menuButton");
        const menuOffcanvas = document.querySelector(".offcanvas");
        const menuOverlay = document.querySelector(".offcanvas-overlay");

        if (menuButton && menuOffcanvas && menuOverlay) {
            menuButton.addEventListener("click", () => {
                menuOffcanvas.classList.toggle("open");
                menuOverlay.classList.toggle("open");
                document.body.classList.toggle("elementor-offcanvas-active");
            });

            const closeMenu = () => {
                menuOffcanvas.classList.remove("open");
                menuOverlay.classList.remove("open");
                document.body.classList.remove("elementor-offcanvas-active");
            };

            menuOverlay.addEventListener("click", closeMenu);
            menuOffcanvas.querySelectorAll("nav a").forEach((link) => {
                link.addEventListener("click", closeMenu);
            });
        }

        // --- GESTION PANIER (NANO STORES) ---

        // Initialisation forcée au chargement (on ferme le panier par défaut)
        const initialState = cartStore.get();
        cartStore.set({ ...initialState, isOpen: false, loading: false });

        // Souscription au store pour mettre à jour l'UI (badge et bouton flottant)
        cartStore.subscribe((state: any) => {
            // Compteur Header
            if (cartCountEl && cartCompteurEl) {
                cartCountEl.textContent = String(state.totals.count);
                if (state.totals.count > 0) {
                    cartCompteurEl.classList.remove("hidden");
                    cartCompteurEl.classList.add("visible");
                } else {
                    cartCompteurEl.classList.add("hidden");
                    cartCompteurEl.classList.remove("visible");
                }
            }

            // Bouton "Commander" flottant (mobile)
            if (resumeOrder) {
                const count = state.totals.count || 0;
                if (count > 0) {
                    const currentCartKey = cartKey.get();
                    resumeOrder.href = `https://dev-shop.meliponini.fr/checkout/?cocart-load-cart=${currentCartKey}`;
                    resumeOrder.style.display = "flex";
                    resumeOrder.setAttribute("aria-hidden", "false");
                } else {
                    resumeOrder.style.display = "none";
                    resumeOrder.setAttribute("aria-hidden", "true");
                }
            }
        });

        // --- GESTION DU BOUTON FLOTTANT COMMANDER (MOBILE) ---
        if (resumeOrder) {
            resumeOrder.addEventListener("click", async (e) => {
                const currentCartKey = cartKey.get();
                if (!currentCartKey) return;

                e.preventDefault();
                resumeOrder.innerText = "Sync...";
                resumeOrder.style.pointerEvents = "none";

                try {
                    const cartData = await getCart();
                    if (!cartData) throw new Error("Sync failed");

                    const key = cartKey.get();
                    const checkoutUrl = `https://dev-shop.meliponini.fr/checkout/?cocart-load-cart=${key}`;

                    setTimeout(() => {
                        window.location.href = checkoutUrl;
                    }, 500);
                } catch (err) {
                    resumeOrder.innerText = "Erreur";
                    setTimeout(() => {
                        resumeOrder.innerText = "Commander";
                        resumeOrder.style.pointerEvents = "auto";
                    }, 2000);
                }
            });
        }

        // --- EVENTS LISTENERS ---
        if (cartButton) {
            cartButton.addEventListener("click", (e) => {
                e.preventDefault();
                toggleCart(true);
            });
        }

        // Intercepter les clics sur les boutons "Ajouter au panier" (si présents avec data-add-to-cart)
        document.body.addEventListener("click", async (e: MouseEvent) => {
            const addBtn = (e.target as HTMLElement)?.closest(
                "[data-add-to-cart]",
            ) as HTMLElement;
            if (addBtn) {
                e.preventDefault();
                const productId = addBtn.dataset.addToCart;
                addBtn.classList.add("loading");
                try {
                    await addToCart(productId, 1);
                    await refreshCart();
                    toggleCart(true); // Ouvre le panier après ajout
                } catch (err) {
                    console.error("Add to cart failed", err);
                } finally {
                    addBtn.classList.remove("loading");
                }
            }
        });

        /* GESTION OMBRE HEADER AU SCROLL */
        const header = document.querySelector(".header-fixe");
        const SCROLL_THRESHOLD = 60;

        if (header) {
            window.addEventListener("scroll", () => {
                const shouldHaveShadow = window.scrollY > SCROLL_THRESHOLD;
                header.classList.toggle("is-scrolled", shouldHaveShadow);
            });
            if (window.scrollY > SCROLL_THRESHOLD) {
                header.classList.add("is-scrolled");
            }
        }

        // Initialisation du panier au chargement
        refreshCart();
    });
</script>

<style>
    /* src/components/Header.astro */
    /* =========================
   HEADER FIXE (LOGO UNIFORME)
========================= */
    .header-fixe {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        border-top: 8px solid #000;

        /* 👇 hauteur pilotée par variable */
        height: var(--header-height);

        /* 👇 taille de police fixe pour éviter l'héritage */
        font-size: 16px;

        background: #fff;
        z-index: 1000;

        /* desktop : PAS d’ombre ici */
        box-shadow: none;

        /* Transition pour l'ombre */
        transition: box-shadow 0.3s ease;
    }

    /* Classe ajoutée en JS au scroll */
    .header-fixe.is-scrolled {
        box-shadow: var(--shadow-subheader);
    }

    .header-inner {
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
    }

    /* =========================
   LOGO — VERROUILLAGE ABSOLU
========================= */
    .header-fixe .logo,
    header.header-fixe a.logo {
        font-family: "abchannel", system-ui, sans-serif !important;

        /* fluide mais contrôlé */
        font-size: 24px !important;
        /* stable partout */

        line-height: 1 !important;
        letter-spacing: 0.2em !important;
        font-weight: 600 !important;

        display: inline-block !important;
        white-space: nowrap !important;
        text-decoration: none !important;
        color: #000 !important;
        transform: translate(-50%, -50%) !important;
        -webkit-transform: translate(-50%, -50%) !important;
        -moz-transform: translate(-50%, -50%) !important;
        -ms-transform: translate(-50%, -50%) !important;
        font-style: normal !important;
        writing-mode: horizontal-tb !important;
        text-orientation: mixed !important;

        /* Centrage absolu parfait */
        position: absolute !important;
        left: 50% !important;
        top: 50% !important;
        z-index: 10000 !important;
        margin: 0 !important;
        padding: 0 !important;
    }

    /* =========================
   PANIER (CUSTOM CART)
========================= */
    .custom-cart-icon {
        position: absolute;
        right: 60px;
        top: 50%;
        transform: translateY(-50%);
        text-decoration: none;
        display: flex;
        align-items: center;
        z-index: 10000;
        background: none;
        border: none;
        padding: 0;
        cursor: pointer;
        color: #000 !important; /* Force le noir sur le bouton */
        -webkit-tap-highlight-color: transparent; /* Supprime le flash bleu au clic iOS */
        outline: none;
    }

    .custom-cart-icon iconify-icon {
        font-size: 24px;
        vertical-align: middle;
        color: #000 !important; /* Force le noir au lieu du bleu */
        display: inline-block;
        --iconify-color: #000; /* Variable native de certains sets iconify */
        stroke: #000;
        fill: #000;
    }

    .custom-cart-count {
        display: block; /* obligatoire ici */
        line-height: 1;
        white-space: nowrap; /* éviter retour ligne */
        max-width: 100%; /* reste dans la div */
        text-align: center;
        font-size: 8px;
        color: white;
    }
    .custom-cart-compteur {
        position: absolute;
        top: -10px;
        right: -15px;
        width: 20px; /* taille fixe */
        height: 20px; /* taille fixe */
        background: black;
        display: flex; /* centrer avec flexbox */
        align-items: center;
        justify-content: center;
        padding: 4px 6px;
        border-radius: 50%;
        font-weight: bold;
    }

    .custom-cart-compteur.hidden {
        display: none !important;
    }
    .custom-cart-compteur.visible {
        display: flex !important; /* Et pas block */
    }

    /* =========================
   SUB HEADER (MENU DESKTOP)
========================= */
    .menu-sticky {
        position: absolute;
        top: var(--header-height);
        left: 0;
        right: 0;
        background: #fff;
        z-index: 900;

        /* 👇 ombre desktop */
        box-shadow: var(--shadow-subheader);
    }

    .menu-sticky nav {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 2.5rem;
    }

    .menu-sticky ul {
        display: flex;
        gap: 1.8rem;
        list-style: none;
        margin: 0;
        padding: 1.4rem 0;
    }

    .menu-sticky ul li a {
        position: relative;
        text-decoration: none;
        color: #000;
        font-size: 0.85rem;
    }

    /* =========================
   SOULIGNEMENT LIENS
========================= */
    .menu-sticky ul li a::after,
    .offcanvas nav a::after {
        content: "";
        position: absolute;
        left: 0;
        bottom: -4px;
        width: 100%;
        height: 1px;
        background: currentColor;
        transform: scaleX(0);
        transform-origin: left;
        transition: transform 0.25s ease;
    }

    .menu-sticky ul li a.active,
    .offcanvas nav a.active {
        color: #999; /* Gris clair demandé pour l'état actif */
        /* font-weight: 500; Maybe? User asked for color */
    }

    .menu-sticky ul li a:hover::after,
    .offcanvas nav a:hover::after,
    .menu-sticky ul li a.active::after,
    .offcanvas nav a.active::after {
        transform: scaleX(1);
    }

    /* =========================
   OFF-CANVAS MOBILE (GAUCHE)
========================= */
    .offcanvas,
    .offcanvas-overlay {
        display: none;
    }

    .offcanvas {
        position: fixed;
        top: var(--header-height);
        left: 0;
        width: 60vw;
        max-width: 320px;
        height: calc(100vh - var(--header-height));
        background: #fff;
        padding: 2.5rem 1.5rem;
        transform: translateX(-100%);
        transition: transform 0.45s cubic-bezier(0.25, 0.8, 0.25, 1);
        z-index: 1000;

        box-shadow: var(--shadow-subheader);
    }

    .offcanvas.open {
        transform: translateX(0);
    }

    .offcanvas nav {
        display: flex;
        flex-direction: column;
        gap: 1.6rem;
    }

    .offcanvas nav a {
        position: relative;
        text-decoration: none;
        color: #000;
        font-size: 0.9rem;
    }

    /* =========================
   OVERLAY
========================= */
    .offcanvas-overlay {
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.4);
        backdrop-filter: blur(2px);
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.3s ease;
        z-index: 700;
    }

    .offcanvas-overlay.open {
        opacity: 1;
        pointer-events: auto;
    }

    /* =========================
   MOBILE LARGE + TABLETTE PORTRAIT
========================= */
    @media (max-width: 768px) {
        .menu-sticky nav {
            gap: 1.5rem; /* Réduit l'espace entre les éléments */
        }

        .menu-sticky ul {
            gap: 1.2rem; /* Réduit l'espace entre les liens */
            padding: 1.2rem 1rem; /* Ajoute du padding latéral */
        }

        .menu-sticky ul li a {
            font-size: 0.6rem; /* Légèrement plus petit */
        }
    }

    /* =========================
   MOBILE — CORRECTIONS CIBLÉES
========================= */
    @media (max-width: 600px) {
        /* ❌ SUB MENU DESKTOP */
        .menu-sticky {
            display: none !important;
        }

        .menu-wrapper {
            display: none;
        }

        /* ✅ OMBRE SOUS LE HEADER EN MOBILE */
        .header-fixe {
            box-shadow: var(--shadow-subheader);
        }

        .header-fixe .logo {
            font-size: 20px;
        }

        .custom-cart-icon {
            right: 40px;
        }

        .offcanvas,
        .offcanvas-overlay {
            display: block;
        }
    }
</style>
