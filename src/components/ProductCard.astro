---
import { Button } from "@/components/ui/button";

const { product } = Astro.props;
console.log(
    `[ProductCard] Render: ${product.name} | Available: ${product.available}`,
);
---

<article class="product-card fade-up">
    <!-- Image -->
    <a href={`/product/${product.slug}`} class="product-link">
        <div class="product-image-container">
            <img src={product.image} alt={product.name} loading="lazy" />
        </div>
    </a>

    <!-- Numéro (N° 27) -->
    <a href={`/product/${product.slug}`} class="product-link-name">
        <h2 class="product-name">{product.name}</h2>
    </a>

    <!-- Nom du miel (miel de tubuna) -->
    <p class="product-display-name">{product.displayName}</p>

    <!-- Nom latin scientifique (dans excerpt) -->
    {
        product.excerpt && (
            <div class="product-excerpt" set:html={product.excerpt} />
        )
    }

    <!-- Prix ou Message indisponibilité (Même niveau) -->
    <div class="product-status-block">
        {
            product.available ? (
                <p class="product-price">{product.price} €</p>
            ) : (
                <p class="product-unavailable">Édition à venir</p>
            )
        }
    </div>

    <!-- Bouton -->
    <div class="product-actions-wrapper">
        {
            product.available ? (
                <div class="product-actions">
                    <a
                        href={`/product/${product.slug}`}
                        class="flex-grow max-w-[160px] no-underline"
                    >
                        <Button
                            variant="outline"
                            className="w-full bg-white text-black border border-black hover:bg-zinc-100 hover:text-black transition-all"
                        >
                            Découvrir
                        </Button>
                    </a>
                    <Button
                        size="icon"
                        className="add-to-cart-direct h-12 w-12 bg-black text-white hover:bg-black/90 shadow-none border-none"
                        data-product-id={product.id}
                        aria-label={`Ajouter ${product.name} au panier`}
                    >
                        <iconify-icon
                            icon="carbon:shopping-cart-plus"
                            style="font-size: 16px;"
                        />
                        <span class="btn-loader" style="display: none;">
                            ...
                        </span>
                    </Button>
                </div>
            ) : (
                <a
                    href={`/product/${product.slug}`}
                    class="w-full max-w-[215px] no-underline"
                >
                    <Button
                        variant="outline"
                        className="w-full bg-zinc-50 text-zinc-400 border-zinc-200 shadow-sm hover:bg-zinc-100 hover:text-zinc-600 transition-all font-bold uppercase tracking-widest text-[10px]"
                    >
                        Découvrir
                    </Button>
                </a>
            )
        }
    </div>
</article>

<script>
    import { addToCart } from "../lib/cocart.js";
    import { refreshCart, toggleCart } from "../lib/cartStore.js";

    // Gestion de l'ajout au panier direct depuis la carte
    const setupAddButtons = () => {
        const addButtons = document.querySelectorAll(".add-to-cart-direct");
        addButtons.forEach((btn) => {
            // Éviter les doubles écouteurs
            if (btn.getAttribute("data-listener")) return;
            btn.setAttribute("data-listener", "true");

            btn.addEventListener("click", async (e) => {
                const target = e.currentTarget as HTMLButtonElement;
                const productId = target.getAttribute("data-product-id");
                const icon = target.querySelector("iconify-icon") as any | null; // Casting any pour accéder aux props iconify
                const loader = target.querySelector(
                    ".btn-loader",
                ) as HTMLElement | null;

                if (!productId) return;

                // UI loading
                target.disabled = true;
                if (icon) icon.style.display = "none";
                if (loader) loader.style.display = "inline";

                try {
                    await addToCart(productId, 1);
                    await refreshCart();
                    toggleCart(true); // Ouvre le mini-panier

                    // --- État de SUCCÈS (3 secondes) ---
                    if (icon) {
                        icon.setAttribute(
                            "icon",
                            "streamline:shopping-cart-check",
                        );
                        icon.style.color = "#28a745"; // Vert
                        icon.style.display = "block";
                    }
                    if (loader) loader.style.display = "none";

                    setTimeout(() => {
                        if (icon) {
                            icon.setAttribute(
                                "icon",
                                "carbon:shopping-cart-plus",
                            );
                            icon.style.color = ""; // Retour normal
                        }
                    }, 3000);
                } catch (err) {
                    console.error("Failed to add to cart", err);
                    if (icon) icon.style.display = "block";
                } finally {
                    target.disabled = false;
                    if (loader) loader.style.display = "none";
                }
            });
        });
    };

    // Initialisation
    setupAddButtons();

    // Ré-initialiser si le contenu change (ex: filtres)
    document.addEventListener("astro:after-swap", setupAddButtons);
</script>

<style>
    .product-card {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        width: 100%;
        height: 100%;
        box-sizing: border-box;
        transition: all 0.75s cubic-bezier(0.65, 0, 0.35, 1);
        margin-bottom: 2rem;
    }

    .product-link {
        text-decoration: none;
        color: inherit;
        display: block;
        width: 100%;
        order: 1;
    }

    .product-image-container {
        width: 100%;
        display: flex;
        justify-content: center;
        align-items: center;
        aspect-ratio: 1 / 1;
        margin-bottom: 0;
        overflow: hidden;
        transition: transform 0.75s cubic-bezier(0.65, 0, 0.35, 1);
    }

    .product-card img {
        width: 100%;
        max-width: 280px;
        height: 100%;
        object-fit: contain;
        margin-bottom: 0 !important;
    }

    .product-link-name {
        order: 1; /* Match name order */
        text-decoration: none;
        color: inherit;
        display: block;
        width: 100%;
        margin-top: -20px;
    }

    .product-name {
        font-size: clamp(0.95rem, 2.5vw, 1.15rem) !important;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        margin: 0 !important;
        font-weight: 400;
        transition: all 0.8s cubic-bezier(0.65, 0, 0.35, 1);
    }

    .product-display-name {
        order: 2;
        font-weight: 400;
        font-size: 0.7rem;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: hsl(var(--muted-foreground));
        margin: 0;
    }

    .product-excerpt {
        order: 3;
        margin: 5px 0;
        font-size: 0.85rem;
        font-style: italic;
        font-family: Helvetica, Arial, sans-serif;
        opacity: 0.8;
        line-height: 1.4;
    }

    .product-excerpt :global(p),
    .product-excerpt :global(em) {
        margin: 0;
        display: inline;
    }

    .product-excerpt :global(strong:first-of-type) {
        font-weight: 700;
    }

    .product-status-block {
        order: 4;
        width: 100%;
    }

    .product-price,
    .product-unavailable {
        font-size: 0.95rem;
        margin: 10px 0;
        line-height: 1.2;
        display: block;
        min-height: 1.2em;
        transition: all 0.8s cubic-bezier(0.65, 0, 0.35, 1);
    }

    .product-price {
        font-weight: 700;
        letter-spacing: 0.1em;
        color: hsl(var(--accent-gold));
    }

    .product-unavailable {
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: hsl(var(--muted-foreground));
        font-weight: 500;
    }

    .product-actions-wrapper {
        width: 100%;
        margin-top: 0;
        padding-top: 0;
        display: flex;
        justify-content: center;
        order: 10;
    }

    .product-actions {
        display: flex;
        align-items: center;
        gap: 10px;
        justify-content: center;
        width: 100%;
    }

    @media (max-width: 768px) {
        .product-card img {
            max-width: 220px;
        }

        .product-name {
            font-size: 0.9rem !important;
        }

        /* --- MODE 2 COLONNES (Toggle Mobile) --- */
        :global(.row-layout) .product-card {
            padding-inline: 8px;
            display: grid !important;
            grid-template-rows: auto 40px auto 30px auto;
            gap: 0px;
            height: auto !important;
            align-items: start;
        }

        :global(.row-layout) .product-link {
            width: 100%;
            margin-bottom: 6px;
        }

        :global(.row-layout) .product-image-container {
            width: 100%;
            aspect-ratio: 1 / 1;
            position: relative;
            background: #fff;
            height: auto;
        }

        :global(.row-layout) .product-image-container img {
            width: 100%;
            max-width: none;
            height: 100%;
            object-fit: contain;
        }

        :global(.row-layout) .product-name {
            font-size: 1rem !important;
            margin: 0 !important;
            letter-spacing: -0.5px;
            line-height: 1.1;
            display: flex;
            align-items: center;
            justify-content: center;
            text-align: center;
            overflow: hidden;
            height: 38px;
        }

        :global(.row-layout) .product-display-name {
            font-size: 0.7rem;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            margin: 0 !important;
            height: 12px;
            line-height: 12px;
        }

        :global(.row-layout) .product-excerpt {
            font-size: 0.65rem;
            margin: 2px 0 0 0 !important;
            line-height: 1.1;
            display: flex;
            align-items: center;
            justify-content: center;
            opacity: 0.7;
            height: 34px;
            overflow: hidden;
        }

        :global(.row-layout) .product-status-block {
            height: 30px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        :global(.row-layout) .product-price,
        :global(.row-layout) .product-unavailable {
            font-size: 0.8rem;
            margin: 0 !important;
        }

        :global(.row-layout) .product-actions-wrapper {
            margin-top: 8px;
            padding-bottom: 12px;
            width: 100%;
        }

        :global(.row-layout) .btn-add-icon svg {
            width: 16px;
            height: 16px;
        }
        :global(.row-layout) .product-actions {
            gap: 8px;
        }
    }
</style>
