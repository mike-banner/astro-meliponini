---
/* COMPONENT : ProductCard */
const { product } = Astro.props;
---

<article class="product-card">
    <!-- Image -->
    <img src={product.image} alt={product.name} loading="lazy" />

    <!-- Numéro -->
    <p class="product-number">N° {product.number}</p>

    <!-- Nom -->
    <h2 class="product-name">{product.name}</h2>

    <!-- Nom latin -->
    <em class="product-latin">{product.latin}</em>

    <!-- Statut stock -->
    {
        !product.available && (
            <p class="product-unavailable">Bientôt disponible</p>
        )
    }

    <!-- Prix -->
    {product.available && <p class="product-price">{product.price} €</p>}

    <!-- Actions -->
    <div class="product-actions">
        <a href={`/products/${product.slug}`} class="btn-discover">
            Découvrir
        </a>

        {
            product.available && (
                <button class="btn-cart" aria-label="Ajouter au panier">
                    🛒
                </button>
            )
        }
    </div>
</article>

<style>
    /* =========================
   CARD
========================= */
    .product-card {
        text-align: center;
    }

    /* Image */
    .product-card img {
        width: 40%;
        height: auto;
        object-fit: cover;
    }

    /* =========================
   TEXT
========================= */
    .product-number {
        font-size: 0.7rem;
        letter-spacing: 0.12em;
        margin-bottom: 0.3rem;
    }

    .product-name {
        font-size: 0.95rem;
        font-weight: 400;
        margin: 0.2rem 0;
    }

    .product-latin {
        display: block;
        font-size: 0.8rem;
        opacity: 0.7;
        margin-bottom: 0.4rem;
    }

    /* ÉTAT PRIX / DISPONIBILITÉ — ALIGNÉS */
    .product-card .product-price,
    .product-card .product-unavailable {
        margin-bottom: 0.9rem; /* 👈 même espace */
    }

    /* Différenciation visuelle uniquement */
    .product-card .product-price,
    .product-card .product-unavailable {
        font-size: 0.7rem;
    }

    .product-card .product-unavailable {
        color: #b00000;
    }
    /* =========================
   ACTIONS
========================= */
    .product-actions {
        display: flex;
        justify-content: center;
        gap: 0.6rem;
    }

    /* Découvrir */
    .btn-discover {
        border: 1px solid #000;
        padding: 0.45rem 0.75rem;
        font-size: 0.75rem;
        text-decoration: none;
        color: #000;
        white-space: nowrap;
    }

    /* Panier */
    .btn-cart {
        background: #000;
        color: #fff;
        border: none;
        padding: 0.45rem 0.55rem;
        font-size: 0.75rem;
        cursor: pointer;
    }

    /* =========================
   MOBILE 2 COLONNES
========================= */
    @media (max-width: 768px) {
        .product-card img {
            width: 100%;
        }

        .product-actions {
            gap: 0.4rem; /* évite le collage */
        }

        .product-card .product-actions .btn-discover {
            padding: 0.45rem 0.75rem;
            font-size: 0.75rem;
        }

        .product-card .product-actions .btn-cart {
            padding: 0.45rem 0.55rem;
            font-size: 0.75rem;
        }
    }
</style>
