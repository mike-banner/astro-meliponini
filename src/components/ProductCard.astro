---
/* COMPONENT : ProductCard */
const { product } = Astro.props;
---

<article class="product-card">
    <!-- Image -->
    <img src={product.image} alt={product.name} loading="lazy" />

    <!-- Numéro -->
    <p class="product-number">N° {product.number}</p>

    <!-- Nom -->
    <h2 class="product-name">{product.name}</h2>

    <!-- Nom latin -->
    <em class="product-latin">{product.latin}</em>

    <!-- Statut stock -->
    {
        !product.available && (
            <p class="product-unavailable">Bientôt disponible</p>
        )
    }

    <!-- Prix -->
    {product.available && <p class="product-price">{product.price} €</p>}

    <!-- Action UNIQUE -->
    <div class="product-actions">
        <a
            href={`/products/${product.category}`}
            data-astro-prefetch
            class="btn-discover"
        >
            Découvrir
        </a>
    </div>
</article>
