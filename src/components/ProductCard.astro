---
/* src/components/ProductCard.astro */
/* COMPONENT : ProductCard */
const { product } = Astro.props;
console.log(
    `[ProductCard] Render: ${product.name} | Available: ${product.available}`,
);
---

<article class="product-card">
    <!-- Image -->
    <a href={`/product/${product.slug}`} class="product-link">
        <div class="product-image-container">
            <img src={product.image} alt={product.name} loading="lazy" />
        </div>
    </a>

    <!-- Numéro (N° 27) -->
    <a href={`/product/${product.slug}`} class="product-link-name">
        <h2 class="product-name">{product.name}</h2>
    </a>

    <!-- Nom du miel (miel de tubuna) -->
    <p class="product-display-name">{product.displayName}</p>

    <!-- Nom latin scientifique (dans excerpt) -->
    {
        product.excerpt && (
            <div class="product-excerpt" set:html={product.excerpt} />
        )
    }

    <!-- Prix ou Message indisponibilité (Même niveau) -->
    <div class="product-status-block">
        {
            product.available ? (
                <p class="product-price">{product.price} €</p>
            ) : (
                <p class="product-unavailable">Bientôt disponible</p>
            )
        }
    </div>

    <!-- Bouton -->
    <div class="product-actions-wrapper">
        {
            product.available ? (
                <div class="product-actions">
                    <a
                        href={`/product/${product.slug}`}
                        class="btn-discover"
                        aria-label={`Découvrir ${product.name}`}
                    >
                        <span class="btn-text">Découvrir</span>
                    </a>
                    <button
                        class="btn-add-icon add-to-cart-direct"
                        data-product-id={product.id}
                        aria-label={`Ajouter ${product.name} au panier`}
                    >
                        <iconify-icon
                            icon="carbon:shopping-cart-plus"
                            style="font-size: 20px;"
                        />
                        <span class="btn-loader" style="display: none;">
                            ...
                        </span>
                    </button>
                </div>
            ) : (
                <button
                    class="btn-discover disabled"
                    disabled
                    aria-label="Produit non disponible"
                >
                    RUPTURE
                </button>
            )
        }
    </div>
</article>

<script>
    import { addToCart } from "../lib/cocart.js";
    import { refreshCart, toggleCart } from "../lib/cartStore.js";

    // Gestion de l'ajout au panier direct depuis la carte
    const setupAddButtons = () => {
        const addButtons = document.querySelectorAll(".add-to-cart-direct");
        addButtons.forEach((btn) => {
            // Éviter les doubles écouteurs
            if (btn.getAttribute("data-listener")) return;
            btn.setAttribute("data-listener", "true");

            btn.addEventListener("click", async (e) => {
                const target = e.currentTarget as HTMLButtonElement;
                const productId = target.getAttribute("data-product-id");
                const icon = target.querySelector("iconify-icon") as any | null; // Casting any pour accéder aux props iconify
                const loader = target.querySelector(
                    ".btn-loader",
                ) as HTMLElement | null;

                if (!productId) return;

                // UI loading
                target.disabled = true;
                if (icon) icon.style.display = "none";
                if (loader) loader.style.display = "inline";

                try {
                    await addToCart(productId, 1);
                    await refreshCart();
                    toggleCart(true); // Ouvre le mini-panier

                    // --- État de SUCCÈS (3 secondes) ---
                    if (icon) {
                        icon.setAttribute(
                            "icon",
                            "streamline:shopping-cart-check",
                        );
                        icon.style.color = "#28a745"; // Vert
                        icon.style.display = "block";
                    }
                    if (loader) loader.style.display = "none";

                    setTimeout(() => {
                        if (icon) {
                            icon.setAttribute(
                                "icon",
                                "carbon:shopping-cart-plus",
                            );
                            icon.style.color = ""; // Retour normal
                        }
                    }, 3000);
                } catch (err) {
                    console.error("Failed to add to cart", err);
                    if (icon) icon.style.display = "block";
                } finally {
                    target.disabled = false;
                    if (loader) loader.style.display = "none";
                }
            });
        });
    };

    // Initialisation
    setupAddButtons();

    // Ré-initialiser si le contenu change (ex: filtres)
    document.addEventListener("astro:after-swap", setupAddButtons);
</script>

<style>
    .product-card {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        width: 100%;
        height: 100%;
        box-sizing: border-box;
        /* Ralentissement et courbe plus souple */
        transition: all 0.75s cubic-bezier(0.65, 0, 0.35, 1);
    }

    .product-link {
        text-decoration: none;
        color: inherit;
        display: block;
        width: 100%;
        order: 1;
    }

    /* Aligne les photos entre elles */
    .product-image-container {
        width: 100%;
        display: flex;
        justify-content: center;
        align-items: center;
        aspect-ratio: 1 / 1;
        margin-bottom: 0;
        overflow: hidden;
        transition: transform 0.75s cubic-bezier(0.65, 0, 0.35, 1);
    }

    .product-card img {
        width: 100%;
        height: 100%;
        object-fit: contain;
    }

    .product-link-name {
        order: 2;
        text-decoration: none;
        color: inherit;
        display: block;
        width: 100%;
        margin-top: -20px;
    }

    .product-name {
        font-size: 1.6rem !important;
        letter-spacing: -1.5px;
        margin: 10px 0;
        font-weight: 600;
        transition:
            font-size 0.8s cubic-bezier(0.65, 0, 0.35, 1),
            margin 0.8s cubic-bezier(0.65, 0, 0.35, 1);
    }

    .product-display-name {
        order: 3;
        margin: 0;
    }

    .product-excerpt {
        order: 4;
        margin: 5px 0;
    }

    .product-status-block {
        order: 5;
        width: 100%;
    }

    .product-price,
    .product-unavailable {
        font-size: 0.95rem;
        margin: 10px 0;
        line-height: 1.2;
        display: block;
        min-height: 1.2em;
        transition:
            font-size 0.8s cubic-bezier(0.65, 0, 0.35, 1),
            margin 0.8s cubic-bezier(0.65, 0, 0.35, 1);
    }

    .product-price {
        font-weight: 700;
    }

    .product-unavailable {
        color: #be1010;
        font-weight: 500;
    }

    .product-actions-wrapper {
        width: 100%;
        margin-top: 0; /* ✅ Retrait du margin-top auto */
        padding-top: 0; /* ✅ Retrait du padding-top */
        display: flex;
        justify-content: center;
        order: 10;
    }

    .product-actions {
        display: flex;
        align-items: center;
        gap: 10px;
        justify-content: center;
        width: 100%;
    }

    /* Égalise la taille des boutons */
    .btn-discover,
    .btn-add-icon {
        height: 45px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 5px;
        transition:
            transform 0.2s,
            background 0.2s,
            box-shadow 0.2s;
        border: 1px solid #000;
        cursor: pointer;
        box-sizing: border-box;
    }

    .btn-discover {
        background: #fff;
        color: #000;
        padding: 0 20px;
        text-decoration: none;
        font-size: 0.95rem;
        flex-grow: 1;
        max-width: 160px;
        font-weight: 500;
        transition: all 0.4s ease;
    }

    .btn-add-icon {
        background: #000;
        color: #fff;
        width: 45px;
        padding: 0;
        flex-shrink: 0;
    }

    .btn-discover:hover {
        background: #f9f9f9;
        transform: translateY(-2px);
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
    }

    .btn-add-icon:hover {
        background: #333;
        transform: translateY(-2px);
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
    }

    .btn-discover:active,
    .btn-add-icon:active {
        transform: translateY(0);
    }

    .btn-discover.disabled {
        background: #f0f0f0 !important;
        color: #999 !important;
        cursor: not-allowed !important;
        border: none !important;
        opacity: 0.7;
        flex-grow: 0;
        width: 100%;
        max-width: 215px; /* ✅ Taille équilibrée (approx discover + add + gap) */
        height: 45px; /* ✅ Force la hauteur identique */
    }

    @media (max-width: 768px) {
        .btn-discover,
        .btn-add-icon {
            height: 40px;
        }
        .btn-add-icon {
            width: 40px;
        }
        .product-name {
            font-size: 1.5rem !important;
        }

        /* --- MODE 2 COLONNES (Toggle Mobile) --- */
        :global(.row-layout) .product-card {
            padding-inline: 8px;
            display: grid !important;
            /* Image, Nom, (DisplayName + Excerpt groupés), Status, Actions */
            grid-template-rows: auto 40px auto 30px auto;
            gap: 0px; /* On gère les espaces précisément par item */
            height: auto !important;
            align-items: start;
        }

        :global(.row-layout) .product-link {
            width: 100%;
            margin-bottom: 6px;
        }

        :global(.row-layout) .product-image-container {
            width: 100%;
            aspect-ratio: 1 / 1;
            position: relative;
            background: #fff;
            height: auto;
        }

        :global(.row-layout) .product-image-container img {
            width: 100%;
            height: 100%;
            object-fit: contain;
        }

        :global(.row-layout) .product-name {
            font-size: 1rem !important;
            margin: 0 !important;
            letter-spacing: -0.5px;
            line-height: 1.1;
            display: flex;
            align-items: center;
            justify-content: center;
            text-align: center;
            overflow: hidden;
            height: 38px;
        }

        :global(.row-layout) .product-display-name {
            font-size: 0.7rem;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            margin: 0 !important;
            height: 12px; /* Resserre */
            line-height: 12px;
        }

        :global(.row-layout) .product-excerpt {
            font-size: 0.65rem;
            margin: 2px 0 0 0 !important; /* Petit espace seulement au dessus */
            line-height: 1.1;
            display: flex;
            align-items: center;
            justify-content: center;
            opacity: 0.7;
            height: 34px; /* Resserre */
            overflow: hidden;
        }

        :global(.row-layout) .product-status-block {
            height: 30px; /* Fixe la hauteur du prix/statut */
            display: flex;
            align-items: center;
            justify-content: center;
        }

        :global(.row-layout) .product-price,
        :global(.row-layout) .product-unavailable {
            font-size: 0.8rem;
            margin: 0 !important;
        }

        :global(.row-layout) .product-actions-wrapper {
            margin-top: 8px; /* Un peu plus d'espace au dessus */
            padding-bottom: 12px;
            width: 100%;
        }

        :global(.row-layout) .btn-discover,
        :global(.row-layout) .btn-add-icon {
            height: 38px; /* Plus grand et proportionnel */
        }
        :global(.row-layout) .btn-add-icon {
            width: 38px;
        }
        :global(.row-layout) .btn-add-icon svg {
            width: 16px;
            height: 16px;
        }
        :global(.row-layout) .btn-discover {
            font-size: 0.75rem;
            padding: 0 8px;
            max-width: 110px;
        }
        :global(.row-layout) .product-actions {
            gap: 8px; /* Espace équilibré */
        }
        :global(.row-layout) .btn-discover.disabled {
            height: 38px;
            font-size: 0.75rem;
            max-width: 145px;
        }
    }
</style>
